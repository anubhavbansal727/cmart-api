# LLM — Google AI Studio (free: 500 req/day, no credit card)
# Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Embeddings — OpenAI (pay-as-you-go from day 1, ~$1-2/mo at MVP scale)
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Vector store — Pinecone Serverless (free: 2GB, 5 indexes)
# Apply for Startup Program to avoid 3-week inactivity pause: https://www.pinecone.io/startups/
# Get key at: https://app.pinecone.io
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=cmart-index
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_VECTOR_DIM=1024

# Database — Neon PostgreSQL (free: 0.5GB, no inactivity pausing)
# Get connection string at: https://console.neon.tech
# Local dev: uses Docker Compose postgres (see docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://cmart:cmart@localhost:5432/cmart

# Redis — Upstash Redis (free: 256MB, 500K commands/month, no credit card)
# Get connection URL at: https://console.upstash.com
# Local dev: uses Docker Compose redis (see docker-compose.yml)
REDIS_URL=redis://localhost:6379/0

# App
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Retrieval thresholds (tunable without code changes)
RS_STRONG_THRESHOLD=0.82
RS_MODERATE_THRESHOLD=0.65

# Session config
SESSION_TTL_SECONDS=1800
MAX_CLARIFY_ROUNDS=2

# Rate limiting
RATE_LIMIT_PER_MINUTE=100
